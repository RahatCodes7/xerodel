# Telegram bot token from @BotFather
BOT_TOKEN=
# Bot username (without @), used by the Telegram Login Widget
BOT_USERNAME=

# Channel IDs (negative numbers, e.g. -1001234567890). Get them via @userinfobot or by forwarding a channel message to @RawDataBot
PUBLIC_CHANNEL_ID=
PRIVATE_CHANNEL_ID=

# Comma-separated Telegram user IDs allowed to use /admin and the website admin panel
ADMIN_IDS=

# Random secrets (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=change-me-webhook-secret
SESSION_SECRET=change-me-session-secret

# Public base URL of the website (Cloudflare Tunnel URL). Used for the webhook registration.
BASE_URL=https://example.com

# Set true to run the bot with long-polling instead of a webhook (fallback when the tunnel is down)
USE_POLLING=false

# Minutes before a pending_payment order is auto-cancelled
ORDER_EXPIRY_MINUTES=30

# Server port
PORT=8000

# Website name
SITE_NAME=Xerodel

# Default payment details (can be edited later in the admin panel; admin panel values take precedence)
BKASH_NUMBER=
NAGAD_NUMBER=
PAYMENT_INSTRUCTIONS=Pay via bKash/Nagad to the number shown at checkout, then submit the payment screenshot with the TrxID.

# Insert 3 demo products on first run (set false for production)
SEED_DEMO=true
